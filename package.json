{
    "name": "cuanmeter",
    "version": "2.0.0",
    "description": "Sahamath - kalkulator saham IDX untuk trader Indonesia",
    "scripts": {
        "build": "node scripts/build-bundle.js",
        "build:static": "node scripts/build-static.js",
        "refresh:ipo": "node scripts/refresh-ipo.js",
        "serve:dist": "node dist/server.js",
        "test": "npm run test:ipo && npm run test:arena",
        "test:ipo": "node --test tests/ipo-utils.spec.js",
        "test:arena": "node --test tests/arena-utils.spec.js tests/arena-market.spec.js tests/arena-flow.spec.js tests/arena-agents.spec.js",
        "start": "node server.js",
        "dev": "node --watch server.js"
    },
    "keywords": [
        "stock calculator",
        "trading",
        "indonesia",
        "idx",
        "saham",
        "bursa efek"
    ],
    "author": "Sahamath",
    "license": "MIT",
    "devDependencies": {
        "esbuild": "^0.24.0"
    }
}
